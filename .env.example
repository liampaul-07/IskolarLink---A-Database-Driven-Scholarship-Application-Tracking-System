# Copy this file to .env and fill in the values. Never commit .env.
# No spaces around "=" and no quotes.

PORT=3000

# Database (default XAMPP: user root, blank password)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=iskolarlink

# Required. At least 32 characters or the server refuses to start.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000